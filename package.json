{
  "name": "rami-wiki",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "npm run db:dev && nuxt dev --no-tui",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rami-wiki-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply rami-wiki-db --remote",
    "db:dev": "npm run db:generate && npm run db:migrate"
  },
  "dependencies": {
    "@comark/nuxt": "^0.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "nuxt-mdi": "^2.1.2",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.158.0"
  }
}
